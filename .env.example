PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=data/eventra.sqlite
ADMIN_NAME=Avery Quinn
ADMIN_EMAIL=organizer@eventra.demo
ADMIN_PASSWORD=replace-with-a-long-local-password

# Resend delivery for verification codes.
# The server logs a configuration error when these are missing.
# It does not confirm that a code was sent until Resend accepts the request.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=your_verified_sender_email

# Secret used to hash verification codes. Use a long random value before production.
OTP_PEPPER=
