PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
DATABASE_PATH=data/eventra.sqlite
ADMIN_NAME=Avery Quinn
ADMIN_EMAIL=organizer@eventra.demo
ADMIN_PASSWORD=replace-with-a-long-local-password

# Resend delivery for verification codes.
# Both values are required before Eventra will ask Resend to send a code.
# The server does not confirm that a code was sent until Resend accepts it.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Eventra <your_verified_sender@example.com>

# Secret used to hash verification codes. Use a long random value before any shared deployment.
OTP_PEPPER=replace-with-a-long-random-string

# Optional. Leave these unset for the local simulated checkout.
# Setting both Razorpay key variables switches paid checkout to that provider.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
